{
  "name": "helsingborg-stad/apiv2",
  "description": "Version 2 of helsingborg stad API!",
  "license": "MIT",
  "authors": [
    {
      "name": "Helsingborg Stad",
      "email": "webbredaktionen@helsingborg.se"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "composer",
      "url": "https://packagist.org"
    },
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "require": {
    "composer/installers": "v2.3.0",
    "wpackagist-plugin/redis-cache": "^2.3.0",
    "helsingborg-stad/better-post-ui": "^3.0.0",
    "helsingborg-stad/force-ssl": "3.0.3",
    "johnpbloch/wordpress": "6.9.0",
    "wpackagist-plugin/classic-editor": "^1.6.3",
    "wpackagist-plugin/wp-rest-api-log": "^1.6.9",
    "wpackagist-plugin/wp-rest-filter": "^1.4.3",
    "wpackagist-plugin/simple-smtp": "^1.3.2",
    "helsingborg-stad/api-volunteer-manager": "^0.5.0",
    "helsingborg-stad/active-directory-api-wp-integration": "^3.0",
    "helsingborg-stad/api-alarm-manager": "^2.4.1",
    "wpackagist-plugin/litespeed-cache": "7.7",
    "helsingborg-stad/api-schools-manager": "0.25.6",
    "helsingborg-stad/wpmu-acf-google-maps-key": "1.0.1",
    "helsingborg-stad/wpmu-network-admin-url": "2.0.4",
    "wpackagist-plugin/acf-extended": "0.9.2.3",
    "helsingborg-stad/webhooks-manager": "1.3.0",
    "helsingborg-stad/api-event-manager": "3.12.13",
    "helsingborg-stad/municipio": "6.15.63",
    "helsingborg-stad/blade": "3.5.1",
    "wikimedia/composer-merge-plugin": "^2.1",
    "helsingborg-stad/api-exhibition-manager": "^0.4",
    "helsingborg-stad/modularity-frontend-form": "0.77.15",
    "helsingborg-stad/acf-icon-field": "0.2.46"
  },
  "extra": {
    "path": "/",
    "wordpress-install-dir": "wp",
    "installer-paths": {
      "wp-content/mu-plugins/{$name}": [
        "wpackagist-plugin/simple-smtp",
        "type:wordpress-muplugin"
      ],
      "wp-content/plugins/{$name}": [
        "type:wordpress-plugin"
      ],
      "wp-content/themes/{$name}": [
        "type:wordpress-theme"
      ]
    },
    "merge-plugin": {
      "include": [
        "composer.local.json",
        "wp-content/plugins/*/composer.json",
        "wp-content/mu-plugins/*/composer.json",
        "wp-content/themes/*/composer.json"
      ],
      "recurse": false,
      "replace": true,
      "ignore-duplicates": false,
      "merge-dev": false,
      "merge-extra": false,
      "merge-extra-deep": false,
      "merge-scripts": false
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "johnpbloch/wordpress-core-installer": true,
      "kylekatarnls/update-helper": true,
      "wikimedia/composer-merge-plugin": true
    }
  },
  "scripts": {
    "post-install-cmd": [
      "mkdir -p wp-content/uploads/cache/blade-cache",
      "composer dump-autoload -o"
    ],
    "post-update-cmd": [
      "composer dump-autoload -o"
    ],
    "update-lockfile": "command -v act >/dev/null 2>&1 || brew install act; act -j composer-update --bind",
    "resolve-conflicts": [
      "git fetch origin",
      "git checkout stage",
      "git merge -X ours --no-edit origin/master || true",
      "git commit --no-edit || true"
    ],
    "pin-all-latest": [
      "bash -c 'set -euo pipefail; composer outdated --direct --format=json --ignore-platform-req=ext-imagick | jq -c \".installed[] | select(.latest != null and .latest != \\\"[none matched]\\\") | {name:.name, version:.latest}\" | while read -r row; do PKG=$(echo \"$row\" | jq -r .name); VER=$(echo \"$row\" | jq -r .version); if jq -e --arg p \"$PKG\" \".require | has(\\$p)\" composer.json > /dev/null; then echo \"Updating $PKG to $VER\"; jq --arg p \"$PKG\" --arg v \"$VER\" \".require[\\$p] = \\$v\" composer.json > composer.json.tmp && mv composer.json.tmp composer.json; else echo \"Skipping $PKG (not defined in root composer.json)\"; fi; done'",
      "composer update --lock --ignore-platform-req=ext-imagick"
    ]
  }
}
